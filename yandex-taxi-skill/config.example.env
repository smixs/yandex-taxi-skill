# Конфиг Яндекс Такси. Скопируй в ~/.config/yandex-taxi-skill/config.env, chmod 600.
# Или укажи путь: export TAXI_CONFIG=/путь/config.env
# Здесь только примеры. Реальные адреса, имя и карту вписывает владелец на своей машине.

# Сайт. Вход, карты и цены зависят от страны. Для Узбекистана - taxi.yandex.uz
TAXI_HOST=taxi.yandex.uz
LANG_UI=ru

# Имя браузерного сеанса agent-browser
SESSION=taxi-kit

# Файл со входом (state). Хранить вне git и вне общих папок. Права 600.
STATE=$HOME/.config/yandex-taxi-skill/state.json
# Временные файлы и скриншоты
TMP=/tmp/yandex-taxi-skill

# Как сайт подписывает аккаунт после входа (имя в правом верхнем углу).
# Пусто = проверять только отсутствие кнопки "Войти".
ACCOUNT_NAME="ИМЯ ФАМИЛИЯ"

# Карта. Точная подпись из окна "Способ оплаты", например: Uzcard •••• 0000
CARD_LABEL="Банк •••• 0000"

# Разрешённые тарифы, через |. Порядок = приоритет при равной подаче.
ALLOWED_TARIFFS="Business|Электрик"
# Запрещённые тарифы (справка для людей и тестов, скрипт их не выберет никогда)
FORBIDDEN_TARIFFS="Старт|Комфорт|Комфорт+"

# Места: PLACE_<имя>="широта,долгота". Имя потом используется как точка в командах.
PLACE_home="00.000000,00.000000"
PLACE_work="00.000000,00.000000"
PLACE_airport="00.000000,00.000000"

# Заметки для курьера/водителя (скрипт их не использует, агент читает при заказе)
DOOR_NOTE=""
